{
  "name": "Madurai Weather Dark Theme",
  "dataColors": [
    "#22A7F0",
    "#14D9C4",
    "#7C4DFF",
    "#FFD166",
    "#F97316",
    "#10B981"
  ],
  "background": "#0B1220",
  "foreground": "#FFFFFF",
  "tableAccent": "#22A7F0",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#162338" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#334155" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#0B1220" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#0B1220" } },
            "transparency": 0
          }
        ],
        "labels": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 28,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#CBD5E1" } },
            "fontSize": 12
          }
        ]
      }
    }
  }
}